# ── Supabase ─────────────────────────────────────────────────────────────
# Currently the SHARED iBookshelf project (afkgkmhshitfopddadbr); Uni-Inbox
# is isolated in the uni_inbox schema. The schema must be listed in the
# project's Settings -> API -> Exposed schemas.
SUPABASE_URL=https://afkgkmhshitfopddadbr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SCHEMA=uni_inbox

# ── Mail credential encryption ───────────────────────────────────────────
# 32-byte base64 key for AES-256-GCM at-rest encryption of IMAP/SMTP
# passwords. Generate with:  openssl rand -base64 32
# Losing this key means every user must re-enter their mail passwords.
CREDENTIALS_KEY=

# ── Stripe (optional in dev; app boots without billing configured) ───────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Paste the current live/test price ids created by `npm run stripe:setup`.
STRIPE_PRICE_MONTHLY_V2=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_LIFETIME=

# OAuth mail providers (server-side secrets; never expose these to the web app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ── App ──────────────────────────────────────────────────────────────────
PORT=8080
# Comma-separated allowed dashboard origins (unset = allow all; JWT still required)
CORS_ORIGINS=
# Absolute URL of the deployed dashboard (checkout redirects, email links)
DASHBOARD_URL=http://localhost:5173

# ── Sync tuning ──────────────────────────────────────────────────────────
MAIL_RETENTION_DAYS=90
MAIL_RETENTION_MAX_PER_ACCOUNT=500
INITIAL_SYNC_LIMIT=200
# Sent-mailbox sync. "1" on, anything else off (kill switch).
SENT_SYNC_ENABLED=1
# Send immediately. Set to 1 only if the delayed Undo Send/Send Later queue is desired.
OUTBOX_ENABLED=0
# How far back the first pass over a Sent folder reaches.
SENT_INITIAL_SYNC_LIMIT=100

# ── Web (Vercel env, not read by the API) ────────────────────────────────
VITE_SUPABASE_URL=https://YOURPROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8080
